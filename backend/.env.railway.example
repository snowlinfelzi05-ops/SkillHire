# =====================================================
# SkillHire backend — Railway deployment variables
# Paste these into Railway → Variables (or the MySQL template
# already fills DB_* for you when you add the MySQL plugin).
# Replace the <REPLACE_*> values with the real ones from Railway.
# =====================================================

APP_NAME=SkillHire
APP_ENV=production
# APP_KEY: generate a fresh one locally with `php artisan key:generate --show`
# (never reuse the placeholder below in production)
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY
APP_DEBUG=false
# Set this to your Railway backend URL, e.g. https://skillhire-api.up.railway.app
APP_URL=<REPLACE_WITH_RAILWAY_URL>

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
# Railway MySQL plugin exposes these automatically:
DB_HOST=${MYSQLHOST}
DB_PORT=${MYSQLPORT}
DB_DATABASE=${MYSQLDATABASE}
DB_USERNAME=${MYSQLUSER}
DB_PASSWORD=${MYSQLPASSWORD}

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local
MAIL_MAILER=log

# Sanctum token lifetime in minutes (default 7 days = 10080)
SANCTUM_TOKEN_EXPIRATION=10080

# Comma-separated list of allowed CORS origins.
# Put your frontend URL here, e.g. https://skillhire.netlify.app
CORS_ALLOWED_ORIGINS=<REPLACE_WITH_FRONTEND_URL>