{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksConfigPath": "backend/nixpacks.toml",
    "buildCommand": "cd backend && composer install --no-dev --no-interaction --prefer-dist"
  },
  "deploy": {
    "startCommand": "cd backend && php artisan migrate --force --no-interaction && php artisan serve --host=0.0.0.0 --port=$PORT",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}